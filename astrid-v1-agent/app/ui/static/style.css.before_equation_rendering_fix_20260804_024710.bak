:root {
  --bg: #f5f7f2;
  --panel: #ffffff;
  --ink: #1d2528;
  --muted: #667176;
  --line: #cfd8d1;
  --accent: #1c6b5a;
  --accent-dark: #114b40;
  --warn: #8c3f1f;
}

* {
  box-sizing: border-box;
}

body {
  margin: 0;
  min-height: 100vh;
  background: var(--bg);
  color: var(--ink);
  font-family: "Segoe UI", Arial, sans-serif;
}

button,
textarea,
select {
  font: inherit;
}

button {
  border: 1px solid var(--accent);
  background: var(--accent);
  color: white;
  border-radius: 6px;
  padding: 0.7rem 1rem;
  cursor: pointer;
}

button:hover {
  background: var(--accent-dark);
}

button:disabled {
  opacity: 0.55;
  cursor: not-allowed;
}

button.secondary {
  background: var(--panel);
  color: var(--accent-dark);
}

button.secondary:hover {
  background: #e8f0eb;
}

button.small {
  padding: 0.4rem 0.6rem;
  font-size: 0.9rem;
}

.topbar-actions {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  flex-wrap: wrap;
  justify-content: flex-end;
}

.voice-picker {
  display: grid;
  gap: 0.2rem;
  min-width: 14rem;
  color: var(--muted);
  font-size: 0.82rem;
  font-weight: 700;
}

.voice-picker select {
  width: 100%;
  border: 1px solid var(--line);
  border-radius: 6px;
  background: var(--panel);
  color: var(--ink);
  padding: 0.48rem 0.55rem;
  font-size: 0.92rem;
}

.voice-picker select:focus {
  outline: 2px solid rgba(28, 107, 90, 0.25);
  border-color: var(--accent);
}

.shell {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 360px;
  gap: 1rem;
  height: 100vh;
  padding: 1rem;
}

.chat-pane,
.side-pane {
  min-height: 0;
}

.chat-pane {
  display: grid;
  grid-template-rows: auto minmax(0, 1fr) auto;
  border: 1px solid var(--line);
  background: var(--panel);
}

.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
  padding: 1rem;
  border-bottom: 1px solid var(--line);
}

h1,
h2,
p {
  margin: 0;
}

h1 {
  font-size: 1.25rem;
}

h2 {
  font-size: 1rem;
}

#statusLine {
  margin-top: 0.25rem;
  color: var(--muted);
  font-size: 0.9rem;
}

.messages {
  overflow: auto;
  padding: 1rem;
}

.message {
  max-width: 76ch;
  margin-bottom: 1rem;
  padding-bottom: 1rem;
  border-bottom: 1px solid #edf1ee;
}

.message-label {
  color: var(--muted);
  font-size: 0.85rem;
  font-weight: 700;
  margin-bottom: 0.35rem;
}

.message-body {
  white-space: pre-wrap;
  line-height: 1.5;
}

.message.user {
  margin-left: auto;
}

.message.user .message-body {
  color: var(--accent-dark);
}

.composer {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  gap: 0.75rem;
  padding: 1rem;
  border-top: 1px solid var(--line);
}

.input-stack {
  min-width: 0;
}

.transcript-line {
  min-height: 1.4rem;
  margin-top: 0.45rem;
  color: var(--muted);
  font-size: 0.9rem;
}

textarea {
  width: 100%;
  resize: vertical;
  min-height: 4.5rem;
  max-height: 12rem;
  border: 1px solid var(--line);
  border-radius: 6px;
  padding: 0.75rem;
  color: var(--ink);
}

textarea:focus {
  outline: 2px solid rgba(28, 107, 90, 0.25);
  border-color: var(--accent);
}

.composer-actions {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
}

.mic-button.listening {
  background: var(--warn);
  border-color: var(--warn);
  color: white;
}

.mic-button.listening:hover {
  background: #6f2f18;
}

.side-pane {
  display: grid;
  grid-template-rows: 1fr 1fr 1fr;
  gap: 1rem;
}

.panel {
  min-height: 0;
  overflow: hidden;
  border: 1px solid var(--line);
  background: var(--panel);
  display: grid;
  grid-template-rows: auto minmax(0, 1fr);
}

.panel-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 0.75rem;
  padding: 0.85rem 1rem;
  border-bottom: 1px solid var(--line);
}

#sourceCount {
  min-width: 2rem;
  text-align: center;
  color: var(--muted);
}

.source-list,
.memory-list,
.agent-list {
  overflow: auto;
  padding: 0.75rem;
  color: var(--muted);
}

.source-item,
.memory-item,
.agent-item {
  border-bottom: 1px solid #edf1ee;
  padding: 0.75rem 0;
  color: var(--ink);
}

.source-item:first-child,
.memory-item:first-child,
.agent-item:first-child {
  padding-top: 0;
}

.source-item strong,
.memory-item strong,
.agent-item strong {
  display: block;
  margin-bottom: 0.35rem;
}

.source-item span,
.source-item a {
  display: block;
  color: var(--muted);
  font-size: 0.88rem;
  margin-bottom: 0.25rem;
}

.source-item p,
.memory-item p,
.agent-item p {
  margin-top: 0.4rem;
  color: var(--muted);
  line-height: 1.4;
  font-size: 0.92rem;
}

.agent-tools {
  display: grid;
  gap: 0.5rem;
  padding: 0.75rem;
  border-bottom: 1px solid var(--line);
}

.agent-tools textarea {
  min-height: 4rem;
}

.source-item.web a {
  color: var(--accent-dark);
}

@media (max-width: 900px) {
  .shell {
    grid-template-columns: 1fr;
    height: auto;
    min-height: 100vh;
  }

  .chat-pane {
    min-height: 70vh;
  }

  .side-pane {
    grid-template-rows: minmax(16rem, auto) minmax(16rem, auto);
  }
}

@media (max-width: 620px) {
  .shell {
    padding: 0;
    gap: 0;
  }

  .chat-pane,
  .panel {
    border-left: 0;
    border-right: 0;
  }

  .composer {
    grid-template-columns: 1fr;
  }

  .composer-actions {
    flex-direction: row;
  }

  .topbar {
    align-items: flex-start;
    flex-direction: column;
  }

  .topbar-actions {
    width: 100%;
    justify-content: flex-start;
  }

  .voice-picker {
    width: 100%;
  }
}
